{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Local File System",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "filesys://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": ["source"],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	//
	"capabilities": ["filesystem", "noremote", "security", "nosaas"],
	//
	// Optional:
	//		Supported actions - if not specified, no actions are supported
	//		engine
	//
	"actions": ["export", "delete", "download"],
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	"prefix": "File System",
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["A source component that reads data from the local file system. It ", "enables ingestion of files and documents stored in directories for ", "further processing within the pipeline. Configurable with path settings ", "and file filters, the component supports flexible access to unstructured ", "data across various formats."],
	//
	// Optional:
	//	  The icon is the icon to display in the UI for this node
	//
	"icon": "file-system.svg",
	"documentation": "https://docs.rocketride.org",
	//
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"_source": ["tags"]
	},
	//
	// Optional:
	//		Local fields definitions - these define fields only for the
	//		current service. You may specify them here, or directly
	//		in the config
	"fields": {
		"include": {
			"byMode": {
				"Source": { "description": "This path defines the paths included for Scan, Index, Classify and OCR. By default, its empty.\n\nFormat for Windows : C:\\foldername (for local filesystem) or \\\\file.core.net\\foldername (for shared folders)\n\nFormat for Linux : /file.core.net/foldername" },
				"Pipe": { "description": "Example Path: /Users/usr/Documents/product-images/*" }
			}
		},
		"exclude": {
			"byMode": {
				"Source": { "description": "This path defines the paths excluded for Scan, Index, Classify and OCR. By default, its empty.\n\nFormat for Windows : C:\\foldername (for local filesystem) or \\\\file.core.net\\foldername (for shared folders)\n\nFormat for Linux : /file.core.net/foldername" },
				"Pipe": { "description": "Example Path: /Users/usr/Documents/product-images/*" }
			}
		},
		"excludeExternalDrives": {
			"title": "Exclude external drives",
			"type": "boolean",
			"default": true
		},
		"excludeEnableGlobal": {
			"title": "Exclude typical OS files and directories",
			"type": "boolean",
			"default": true
		},
		"excludeSymlinks": {
			"title": "Exclude symlinks",
			"type": "boolean",
			"default": true
		},
		"filesys.source.parameters": {
			"section": "parameters",
			"properties": ["excludeExternalDrives", "excludeEnableGlobal", "excludeSymlinks"],
			"byMode": {
				"Source": { "title": "Parameters" }
			}
		}
	},
	//
	// Optional:
	//		Per-section titles; a section title defaults to the node title
	//		when not listed here
	//
	"sections": { "Source": "File System", "Pipe": "File System" },
	//
	// Required:
	//		Defines the fields of the service as an ordered list. Each entry
	//		references a field by name, or defines one inline
	//
	"config": [
		"type",
		"actions",
		"source.mode",
		"filesys.source.parameters",
		"include",
		"exclude",
		{ "field": "estimation", "modes": "Source" }
	]
}
