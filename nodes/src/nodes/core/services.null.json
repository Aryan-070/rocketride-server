{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Local File System",
	//
	// Required:
	//		The protocol is the endpoint protocol
	"protocol": "null://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": [],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine
	"capabilities": ["internal"],
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["An internal null endpoint that serves as a no-op source and target, forwarding content into the pipeline without reading from or writing to an external system."],
	//
	// Optional:
	//		Supported actions - if not specified, no actions are supported
	//		engine
	//
	"actions": [],
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "Null",
	//
	//	Optional:
	//		As a pipe component, define what this pipe component takes
	//		and what it produces
	//
	"lanes": {
		"source": ["tags"]
	},
	//
	// Optional:
	//		Local fields definitions - these define fields only for the
	//		current service. You may specify them here, or directly
	//		in the config
	"fields": {
		"null.source.parameters": {
			"section": "parameters",
			"title": "Parameters",
			"properties": []
		},
		"null.target.parameters": {
			"object": "parameters",
			"title": "Parameters",
			"properties": []
		}
	},
	//
	// Optional:
	//		Per-section titles; a section title defaults to the node title
	//		when not listed here
	//
	"sections": { "Source": "Null Source", "Target": "Null Target" },
	//
	// Required:
	//		Defines the fields of the service as an ordered list. Each entry
	//		references a field by name, or defines one inline
	//
	"config": [
		"type",
		{ "field": "actions", "modes": "Source" },
		{ "field": "source.mode", "modes": "Source" },
		{ "field": "null.source.parameters", "modes": "Source" },
		{ "field": "target.mode", "modes": "Target" },
		{ "field": "null.target.parameters", "modes": "Target" }
	]
}
